{
	"schemaVersion": 1,
	"workflows": {
		"cm": {
			"name": "CM Workflow",
			"packageName": "@aibyzero/cm-workflow",
			"version": "0.15.5",
			"source": "github:kingxiaozhe/cm-workflow#91d35b99b8ec84ad50604547d1d7da502d60ba59",
			"license": "MIT",
			"bundled": true,
			"bundledPath": "workflows/cm",
			"envRoot": "BYZ_CM_WORKFLOW_ROOT",
			"skillsPaths": [
				"skills/cm-ai",
				"skills/cm-check",
				"skills/cm-fix",
				"skills/cm-idea",
				"skills/cm-init",
				"skills/cm-prd",
				"skills/cm-refactor",
				"skills/cm-runtime",
				"skills/cm-security",
				"skills/cm-test"
			],
			"promptsPath": "compat/claude-commands",
			"requiredFiles": ["VERSION", "skills/cm-check/SKILL.md"]
		},
		"cm-plugin": {
			"name": "CM Plugin Workflow",
			"packageName": "@aibyzero/cm-plugin-workflow",
			"version": "0.5.0",
			"source": "github:kingxiaozhe/cm-plugin-workflow#d9158aa5c6e143b6a39bfba415cb1d8a2a4051b1",
			"license": "MIT",
			"bundled": true,
			"bundledPath": "workflows/cm-plugin",
			"envRoot": "BYZ_CM_PLUGIN_WORKFLOW_ROOT",
			"skillsPaths": ["skills"],
			"promptsPath": "commands",
			"requiredFiles": ["VERSION", "commands/cm-plugin:check.md"]
		}
	}
}
