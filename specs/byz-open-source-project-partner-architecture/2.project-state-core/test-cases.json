      ],
      "expected": [
        "文件只包含 schema、projectId 和非敏感可移植配置",
        "不包含绝对路径、用户名、目标、决策或记忆正文"
      ],
      "cleanup": [
        "删除临时项目和私有状态"
      ]
    },
